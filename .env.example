# Copy to .env and fill in. Never commit a real .env.

# GCP
GCP_PROJECT=your-project-id
GCP_REGION=asia-northeast3

# BigQuery (read-only, public production data)
BQ_DATASET=food_data
BQ_AGG_TABLE=aggregated_results

# Firebase / Firestore
FIREBASE_PROJECT=your-project-id
# FIRESTORE_EMULATOR_HOST=localhost:8080   # only for local emulator dev

# Auth
JWT_AUDIENCE=your-project-id
API_KEY_REQUIRED=false

# Behaviour
RATE_LIMIT_PER_HOUR=100
CACHE_TTL_SEC=300
CORS_ORIGINS=https://your-frontend-domain

# Test mode (true switches Firestore + BigQuery to in-memory stubs)
TEST_MODE=false

# Frontend (Vite reads VITE_*)
VITE_API_BASE=https://your-cloud-run-url
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
